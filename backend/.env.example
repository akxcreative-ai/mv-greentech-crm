# Server Configuration
PORT=5000
NODE_ENV=development

# Database URLs (PostgreSQL - pooled and direct for Prisma / Supabase / Neon / PgBouncer)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mv_greentech_crm?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/mv_greentech_crm?schema=public"

# Authentication
JWT_SECRET="mv-greentech-super-secret-jwt-key-2026-production"
JWT_EXPIRES_IN="7d"

# CORS configuration (comma separated origins)
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# Uploads
UPLOAD_DIR="./uploads"
